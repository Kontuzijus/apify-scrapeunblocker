{
  "actorSpecification": 1,
  "fields": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "title": "Scraped URL",
        "description": "The URL that was scraped",
        "example": "https://etherscan.io/address/0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045"
      },
      "html": {
        "type": "string",
        "title": "HTML",
        "description": "Full page HTML returned for the URL (present when parsed_data is false, or when parsed_data found nothing to extract)",
        "example": "<html>...</html>"
      },
      "data_extracted": {
        "type": "boolean",
        "title": "Data extracted",
        "description": "false when parsed_data found no structured data on the page; the rendered page is then in html (absent on a successful parse)",
        "example": false
      },
      "detail": {
        "type": "string",
        "title": "Detail",
        "description": "Explanation sent with data_extracted false",
        "example": "The page was rendered, but no structured data could be extracted from it."
      },
      "data": {
        "type": "object",
        "title": "Parsed data",
        "description": "Structured JSON extracted from the page (present when parsed_data is true); shape varies by page type",
        "example": {
          "results": {
            "items": [
              {
                "title": "Example Business",
                "rating": 4.5,
                "reviews": 128,
                "url": "https://www.yelp.com/biz/example-business"
              }
            ]
          }
        }
      }
    }
  },
  "views": {
    "overview": {
      "title": "Overview",
      "description": "Raw HTML output (parsed_data = false)",
      "transformation": {
        "fields": ["url", "html"]
      },
      "display": {
        "component": "table",
        "properties": {
          "url": {
            "label": "Scraped URL",
            "format": "link"
          },
          "html": {
            "label": "HTML",
            "format": "text"
          }
        }
      }
    },
    "parsed": {
      "title": "Parsed data",
      "description": "Structured JSON output (parsed_data = true); extracted fields vary by page type",
      "transformation": {
        "fields": ["url", "data"]
      },
      "display": {
        "component": "table",
        "properties": {
          "url": {
            "label": "Scraped URL",
            "format": "link"
          },
          "data": {
            "label": "Parsed data",
            "format": "object"
          }
        }
      }
    }
  }
}
